DOMAIN=vault.miszori.dev
ACME_EMAIL=you@example.com
# A specific LOCAL interface address (not 0.0.0.0). If behind NAT, use the LAN address.
PUBLIC_BIND_IP=192.0.2.10
# WireGuard advertises this public DNS/IP endpoint and configurable UDP port.
# Forward/open this UDP port to PUBLIC_BIND_IP if the server is behind NAT.
WIREGUARD_ENDPOINT=vault.miszori.dev
WIREGUARD_PORT=51821
# One configuration per device; comma-separated alphanumeric names.
WIREGUARD_PEERS=admin
# IPv4 /24 only. Must not overlap host, Docker, or client networks.
WIREGUARD_SUBNET=10.13.13.0/24
# Address INSIDE the container's tunnel, not an address on the host.
# Admin URL: https://10.13.13.1/admin (VPN-only, private local CA).
VPN_BIND_IP=10.13.13.1
# Trust forwarded client IPs only from this private Docker range (/24 through /32).
# Change only together with ALL fixed backend subnet/IP/upstream settings in compose.yaml.
TRUSTED_PROXY_CIDR=172.30.0.0/24
ADMIN_USER=admin
# One-time enrollment token: openssl rand -hex 32
# Set the actual admin password in the browser on first sign-in, never here.
# This token may be removed after enrollment; keep the packages volume.
ADMIN_SETUP_TOKEN=
# Global ciphertext quota; default 100 GiB. Leave disk headroom for metadata and OS.
MAX_STORAGE_BYTES=107374182400
# Admission limits; authenticated chunk calls are not rate-limited per minute.
MAX_CONCURRENT_REQUESTS=64
MAX_CONCURRENT_DOWNLOADS=4
MAX_CONCURRENT_UPLOADS=2
MAX_BACKEND_CONNECTIONS=128
PUBLIC_REQUESTS_PER_MINUTE=600
AUTH_FAILURES_PER_MINUTE=60
