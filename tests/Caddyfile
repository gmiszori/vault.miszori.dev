{
	admin off
	auto_https off
	log {
		format filter {
			wrap json
			fields {
				request>headers>X-Claim-Token delete
				request>headers>X-Upload-Token delete
				request>headers>Authorization delete
				request>headers>Cookie delete
				# Recipient addresses and browsers are kept only in sealed retrieval records.
				request>remote_ip delete
				request>client_ip delete
				request>headers>User-Agent delete
			}
		}
	}
	servers {
		max_header_size 16KB
		timeouts {
			read_header 10s
			idle 1m
		}
	}
}

(headers) {
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; worker-src 'self'; frame-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; object-src 'none'"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Cache-Control no-store
	}
}

(proxy) {
	reverse_proxy {$API_UPSTREAM:172.30.0.2:8080} {
		header_up X-Real-IP {remote_host}
		header_up -Forwarded
		header_up -X-Forwarded-For
		flush_interval -1
		transport http {
			max_conns_per_host 64
			keepalive 1m
			keepalive_idle_conns_per_host 16
		}
	}
}

:8080 {
	import headers
	root * /srv
	handle / {
		rewrite * /home.html
		templates
		file_server
	}
	handle /local-download/* {
		respond "" 404
	}
	@private path /admin /admin/* /admin.html /admin.js /api/admin /api/admin/*
	handle @private {
		respond "Not found" 404
	}
	handle /api/* {
		import proxy
	}
	@page path /package/*
	handle @page {
		rewrite * /index.html
		templates
		file_server
	}
	@assets path /styles.css /public.js /crypto.js /zip.js /download.js /download-worker.js /share-preview.png /favicon.svg /fonts/inter.woff2 /fonts/jetbrains-mono.woff2
	handle @assets {
		file_server
	}
	handle {
		respond "Not found" 404
	}
}

:8081 {
	import headers
	root * /srv
	handle / {
		redir /admin 302
	}
	handle /local-download/* {
		respond "" 404
	}
	handle /admin/api/* {
		uri replace /admin/api/ /api/admin/ 1
		import proxy
	}
	@direct_admin path /api/admin /api/admin/*
	handle @direct_admin {
		respond "Not found" 404
	}
	handle /api/* {
		import proxy
	}
	@page path /admin /admin/
	handle @page {
		rewrite * /admin.html
		file_server
	}
	handle /package/* {
		rewrite * /index.html
		templates
		file_server
	}
	@assets path /styles.css /admin.js /public.js /crypto.js /zip.js /names.js /audit.js /auth.js /download.js /download-worker.js /share-preview.png /favicon.svg /fonts/inter.woff2 /fonts/jetbrains-mono.woff2
	handle @assets {
		file_server
	}
	handle {
		respond "Not found" 404
	}
}
