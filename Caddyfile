{
	admin off
	email {$ACME_EMAIL}
	auto_https disable_redirects
	log {
		format filter {
			wrap json
			fields {
				# Recipient addresses and browsers are kept only in sealed retrieval records,
				# so no request detail is logged: the headers carry credentials, the browser
				# and the visitor's address (Cf-Connecting-Ip, X-Forwarded-For), and the URL
				# carries the package ID.
				request>headers delete
				request>uri delete
				request>remote_ip delete
				request>client_ip delete
			}
		}
	}
	servers {
		# Only the webserver proxy reaches this server. It passes TLS through and
		# prepends a PROXY header with the peer's address, trusted from the
		# proxy's fixed address alone.
		listener_wrappers {
			proxy_protocol {
				allow 172.31.250.2/32
			}
			tls
		}
		# The domain goes through Cloudflare's proxy, so that peer is a Cloudflare
		# server. From Cloudflare's addresses alone, {client_ip} is taken from
		# CF-Connecting-IP and stays the real client; a request from anywhere else
		# can't set it. Ranges from https://www.cloudflare.com/ips/ (checked 2026-10-31).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		protocols h1 h2
		max_header_size 16KB
		timeouts {
			read_header 10s
			idle 1m
		}
	}
}

# Authenticated Origin Pulls. With ORIGIN_PULL=on in .env, the TLS handshake only
# succeeds when the client presents the certificate that Cloudflare sends for this
# zone, issued by our own CA in origin-pull-ca.pem. Other Cloudflare customers share
# Cloudflare's addresses, so the firewall alone can't tell them apart; this can.
# Off by default, for local development without Cloudflare in front. Setup and
# rollback: docs/authenticated-origin-pulls.md in github.com/gmiszori/webserver-proxy.
(origin_pull_on) {
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/origin-pull-ca.pem
		}
	}
}
(origin_pull_off) {
}

import /etc/caddy/common.caddy

:80 {
	abort
}

https://:443 {
	abort
}

http://{$DOMAIN} {
	redir https://{$DOMAIN}{uri} 308
}

https://{$DOMAIN} {
	import common_headers
	import origin_pull_{$ORIGIN_PULL:off}
	# Cloudflare keeps the homepage and its static assets for a day; browsers
	# revalidate with the edge. Scripts and package pages stay no-store, so code
	# that handles keys is never served stale. Bump ?v= on styles.css when it changes.
	@edge_cached path / /styles.css /share-preview.png /favicon.svg /fonts/instrument-sans.woff2 /fonts/instrument-sans-ext.woff2 /fonts/jetbrains-mono.woff2
	header @edge_cached Cache-Control "public, max-age=0, s-maxage=86400"
	root * /srv
	handle / {
		rewrite * /home.html
		templates
		file_server
	}
	# The security contact (RFC 9116); the policy itself is on miszori.dev.
	handle /.well-known/security.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TXT
			Contact: mailto:gergo@miszori.dev
			Expires: 2027-11-01T00:00:00.000Z
			Preferred-Languages: en, de, hu
			Policy: https://miszori.dev/security/
			Canonical: https://{$DOMAIN}/.well-known/security.txt
			TXT 200
	}
	handle /local-download/* {
		respond "" 404
	}
	@private path /admin /admin/* /admin.html /admin.js /api/admin /api/admin/*
	handle @private {
		respond "Not found" 404
	}
	handle /api/* {
		import proxy_api
	}
	@page path /package/*
	handle @page {
		rewrite * /index.html
		templates
		file_server
	}
	@assets path /styles.css /public.js /crypto.js /zip.js /download.js /download-worker.js /share-preview.png /favicon.svg /fonts/instrument-sans.woff2 /fonts/instrument-sans-ext.woff2 /fonts/jetbrains-mono.woff2
	handle @assets {
		file_server
	}
	handle {
		respond "Not found" 404
	}
}
