{
	admin off
	email {$ACME_EMAIL}
	auto_https disable_redirects
	log {
		format filter {
			wrap json
			fields {
				request>headers>X-Claim-Token delete
				request>headers>X-Upload-Token delete
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
	servers {
		# Only the webserver proxy reaches this server. It passes TLS through and
		# prepends a PROXY header with the client's address, trusted from the
		# proxy's fixed address alone, so {remote_host} stays the real client.
		listener_wrappers {
			proxy_protocol {
				allow 172.31.250.2/32
			}
			tls
		}
		protocols h1 h2
		max_header_size 16KB
		timeouts {
			read_header 10s
			idle 1m
		}
	}
}

import /etc/caddy/common.caddy

:80 {
	abort
}

https://:443 {
	abort
}

http://{$DOMAIN} {
	handle / {
		redir https://gergo.miszori.dev 302
	}
	handle {
		redir https://{$DOMAIN}{uri} 308
	}
}

https://{$DOMAIN} {
	import common_headers
	root * /srv
	handle / {
		redir https://gergo.miszori.dev 302
	}
	handle /local-download/* {
		respond "" 404
	}
	@private path /admin /admin/* /admin.html /admin.js /api/admin /api/admin/*
	handle @private {
		respond "Not found" 404
	}
	handle /api/* {
		import proxy_api
	}
	@page path /package/*
	handle @page {
		rewrite * /index.html
		templates
		file_server
	}
	@assets path /styles.css /public.js /crypto.js /zip.js /download.js /download-worker.js /share-preview.png /favicon.svg
	handle @assets {
		file_server
	}
	handle {
		respond "Not found" 404
	}
}
