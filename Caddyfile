{
	admin off
	email {$ACME_EMAIL}
	auto_https disable_redirects
	default_sni {$VPN_BIND_IP:10.0.0.1}
	log {
		format filter {
			wrap json
			fields {
				request>headers>X-Claim-Token delete
				request>headers>X-Upload-Token delete
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
	servers {
		protocols h1 h2
		max_header_size 16KB
		timeouts {
			read_header 10s
			idle 1m
		}
	}
}

(common_headers) {
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; worker-src 'self'; frame-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; object-src 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow, noarchive"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		Cache-Control "no-store"
		-Server
	}
}

(proxy_api) {
	reverse_proxy api:8080 {
		header_up X-Real-IP {remote_host}
		header_up -Forwarded
		header_up -X-Forwarded-For
		header_up -X-Forwarded-Host
		header_up -X-Forwarded-Proto
		flush_interval -1
		transport http {
			max_conns_per_host 64
			keepalive 1m
			keepalive_idle_conns_per_host 16
		}
	}
}

:80 {
	abort
}

https://:443 {
	abort
}

http://{$DOMAIN} {
	handle / {
		redir https://gergo.miszori.dev 302
	}
	handle {
		redir https://{$DOMAIN}{uri} 308
	}
}

https://{$DOMAIN} {
	import common_headers
	root * /srv
	handle / {
		redir https://gergo.miszori.dev 302
	}
	handle /local-download/* {
		respond "" 404
	}
	@private path /admin /admin/* /admin.html /admin.js /api/admin /api/admin/*
	handle @private {
		respond "Not found" 404
	}
	handle /api/* {
		import proxy_api
	}
	@page path /package/*
	handle @page {
		rewrite * /index.html
		templates
		file_server
	}
	@assets path /styles.css /public.js /crypto.js /zip.js /download.js /download-worker.js /share-preview.png /favicon.svg
	handle @assets {
		file_server
	}
	handle {
		respond "Not found" 404
	}
}

:8081 {
	handle / {
		redir https://gergo.miszori.dev 302
	}
	handle {
		redir https://{$VPN_BIND_IP:10.0.0.1}{uri} 308
	}
}

https://{$VPN_BIND_IP:10.0.0.1}:8443 {
	tls internal
	import common_headers
	root * /srv
	handle / {
		redir https://gergo.miszori.dev 302
	}
	handle /local-download/* {
		respond "" 404
	}
	handle /admin/api/* {
		uri replace /admin/api/ /api/admin/ 1
		import proxy_api
	}
	@direct_admin path /api/admin /api/admin/*
	handle @direct_admin {
		respond "Not found" 404
	}
	handle /api/* {
		import proxy_api
	}
	@admin_page path /admin /admin/
	handle @admin_page {
		rewrite * /admin.html
		file_server
	}
	handle /package/* {
		rewrite * /index.html
		templates
		file_server
	}
	@assets path /styles.css /admin.js /public.js /crypto.js /zip.js /names.js /auth.js /download.js /download-worker.js /share-preview.png /favicon.svg
	handle @assets {
		file_server
	}
	handle {
		respond "Not found" 404
	}
}
