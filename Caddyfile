{
	admin off
	email {$ACME_EMAIL}
	auto_https disable_redirects
	log {
		format filter {
			wrap json
			fields {
				request>headers>X-Claim-Token delete
				request>headers>X-Upload-Token delete
				request>headers>Authorization delete
				request>headers>Cookie delete
				# Recipient addresses and browsers are kept only in sealed retrieval records.
				request>remote_ip delete
				request>client_ip delete
				request>headers>User-Agent delete
			}
		}
	}
	servers {
		# Only the webserver proxy reaches this server. It passes TLS through and
		# prepends a PROXY header with the peer's address, trusted from the
		# proxy's fixed address alone.
		listener_wrappers {
			proxy_protocol {
				allow 172.31.250.2/32
			}
			tls
		}
		# The domain goes through Cloudflare's proxy, so that peer is a Cloudflare
		# server. From Cloudflare's addresses alone, {client_ip} is taken from
		# CF-Connecting-IP and stays the real client; a request from anywhere else
		# can't set it. Ranges from https://www.cloudflare.com/ips/ (checked 2026-10-31).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		protocols h1 h2
		max_header_size 16KB
		timeouts {
			read_header 10s
			idle 1m
		}
	}
}

import /etc/caddy/common.caddy

:80 {
	abort
}

https://:443 {
	abort
}

http://{$DOMAIN} {
	redir https://{$DOMAIN}{uri} 308
}

https://{$DOMAIN} {
	import common_headers
	root * /srv
	handle / {
		rewrite * /home.html
		templates
		file_server
	}
	handle /local-download/* {
		respond "" 404
	}
	@private path /admin /admin/* /admin.html /admin.js /api/admin /api/admin/*
	handle @private {
		respond "Not found" 404
	}
	handle /api/* {
		import proxy_api
	}
	@page path /package/*
	handle @page {
		rewrite * /index.html
		templates
		file_server
	}
	@assets path /styles.css /public.js /crypto.js /zip.js /download.js /download-worker.js /share-preview.png /favicon.svg /fonts/instrument-sans.woff2 /fonts/instrument-sans-ext.woff2 /fonts/jetbrains-mono.woff2
	handle @assets {
		file_server
	}
	handle {
		respond "Not found" 404
	}
}
