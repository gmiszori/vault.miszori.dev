{
	email {$ACME_EMAIL}
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

(common_headers) {
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; object-src 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		Cache-Control "no-store"
		-Server
	}
}

(proxy_api) {
	reverse_proxy api:8080 {
		header_up X-Real-IP {remote_host}
		header_up -Forwarded
		header_up -X-Forwarded-For
		header_up -X-Forwarded-Host
		header_up -X-Forwarded-Proto
		flush_interval -1
	}
}

http://{$DOMAIN} {
	redir https://{$DOMAIN}{uri} 308
}

https://{$DOMAIN} {
	import common_headers
	root * /srv
	@private path /admin /admin/* /admin.html /admin.js /api/admin /api/admin/*
	handle @private {
		respond "Not found" 404
	}
	handle /api/* {
		import proxy_api
	}
	@page path / /package/*
	handle @page {
		rewrite * /index.html
		file_server
	}
	@assets path /styles.css /public.js /crypto.js /zip.js
	handle @assets {
		file_server
	}
	handle {
		respond "Not found" 404
	}
}

:8081 {
	redir https://{$DOMAIN}/admin 308
}

https://{$DOMAIN}:8443 {
	import common_headers
	root * /srv
	handle /admin/api/* {
		uri replace /admin/api/ /api/admin/ 1
		import proxy_api
	}
	@direct_admin path /api/admin /api/admin/*
	handle @direct_admin {
		respond "Not found" 404
	}
	handle /api/* {
		import proxy_api
	}
	@admin_page path / /admin /admin/
	handle @admin_page {
		rewrite * /admin.html
		file_server
	}
	handle /package/* {
		rewrite * /index.html
		file_server
	}
	@assets path /styles.css /admin.js /public.js /crypto.js /zip.js
	handle @assets {
		file_server
	}
	handle {
		respond "Not found" 404
	}
}
